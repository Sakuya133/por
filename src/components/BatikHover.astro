---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["batik-hover", className]}>
  <div class="batik-hover__content">
    <slot />
  </div>
</div>

<style>
  .batik-hover {
    position: relative;
    width: 100%;
    perspective: 900px;
  }

  .batik-hover__content {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .batik-hover:hover .batik-hover__content {
      transform: translateY(-6px) rotateX(3deg) rotateY(-4deg) scale(1.035);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .batik-hover__content {
      transition: none;
    }
  }
</style>
