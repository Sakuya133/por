---
interface Props { class: string; color: string }
const { class: className, color } = Astro.props;
---
<span aria-hidden="true" class={`absolute aspect-square ${className}`} style={{ color }}>
  <span class="absolute inset-y-0 left-1/3 w-1/3 bg-current"></span>
  <span class="absolute inset-x-0 top-1/3 h-1/3 bg-current"></span>
</span>
