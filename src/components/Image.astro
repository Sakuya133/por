---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"img"> { fill?: boolean; priority?: boolean }
const { fill = false, priority = false, class: className, ...attributes } = Astro.props;
---
<img
  {...attributes}
  class:list={[className, { "absolute inset-0 h-full w-full": fill }]}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
/>
